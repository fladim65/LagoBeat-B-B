<!DOCTYPE html>
<html lang="it">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Prenotazione LagoBeat</title>

<link rel="stylesheet" href="css/style.css">

</head>

<body>

<h1>Prenota il tuo soggiorno</h1>

<form class="form-prenota">

<label>Nome</label>
<input type="text" required>

<label>Email</label>
<input type="email" required>

<label>Data arrivo</label>
<input type="date">

<label>Data partenza</label>
<input type="date">

<label>Camera</label>

<select>

<option>Camera Matrimoniale - 140€</option>

<option>Camera Vista Lago - 190€</option>

<option>Family Room - 240€</option>

<option>Suite LagoBeat - 280€</option>

</select>

<label>Messaggio</label>

<textarea></textarea>

<button type="submit">Invia richiesta</button>

</form>
<h2>Prenota direttamente</h2>

<a href="https://wa.me/393000000000" class="btn">
Prenota su WhatsApp
</a></body>
</html>
<a href="https://www.booking.com" class="btn">
Prenota su Booking
</a>
